# PaperPilot environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-hex-string

# ── Production only ───────────────────────────────────────────────────────────
# Set to true when running on HTTPS (Render, etc.)
COOKIE_SECURE=false


# ── Storage (optional overrides) ──────────────────────────────────────────────
# DATABASE_URL=sqlite:///./paperpilot.db
# UPLOADS_DIR=./uploads
